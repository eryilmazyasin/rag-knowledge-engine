# ==========================================
# RAG Knowledge Engine - Ortam Değişkenleri
# ==========================================

# 1. Google Gemini API Anahtarı
# Google AI Studio üzerinden ücretsiz alabilirsiniz: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_BURAYA_GEMINI_API_KEYINIZI_YAZIN

# 2. PostgreSQL + pgvector Bağlantı Dizesi
# Docker Compose varsayılan yapılandırması:
# postgresql://[kullanici]:[sifre]@[host]:[port]/[veritabani_adi]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# 3. Next.js / Node Ortamı
NODE_ENV=development